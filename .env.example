# Copy this file to ".env" and fill in the values. NEVER share or upload the .env file.

# From MongoDB Atlas: Connect > Drivers > copy the connection string.
# Username is already filled in. Replace PASTE_PASSWORD_HERE and YOUR_CLUSTER_HOST.
MONGODB_URI=mongodb+srv://tafsirultalukdar_db_user:PASTE_PASSWORD_HERE@YOUR_CLUSTER_HOST/?retryWrites=true&w=majority
DB_NAME=noore

# First admin key (you can change it later inside the admin panel).
ADMIN_KEY=Noore@2026

# Any long random text, for example 40 random characters.
SESSION_SECRET=change-this-to-a-long-random-text

PORT=3000
